{
  "name": "candeweb",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env server/dev.mjs",
    "start:web": "ng serve",
    "api": "node --env-file-if-exists=.env server/server.mjs",
    "serve:prod": "node --env-file-if-exists=.env server/server.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:i18n": "node scripts/check-i18n.mjs",
    "test:server": "node --test server/**/*.spec.mjs",
    "verify": "npm run test:i18n && npm run test:server && npm test -- --watch=false && npm run build && npm audit --omit=dev"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
