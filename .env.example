# Puerto y host del backend local
API_PORT=3000
API_HOST=127.0.0.1
# DATABASE_PATH=server/data/candemor.db
# UPLOAD_DIR=server/data/uploads
# SETUP_DIR=server/data/setups
# BROWSER_DIR=dist/candeweb/browser
# BACKUP_DIR=server/data/backups

# Producción
NODE_ENV=development
# URL pública usada para construir enlaces de invitación absolutos
PUBLIC_APP_URL=http://localhost:4200
# ADMIN_SETUP_TOKEN=genera-un-token-largo-solo-para-el-primer-alta-en-produccion
# WEB_UPDATES_API_TOKEN=genera-otro-token-largo-para-el-bot-de-discord

# Correo de invitaciones (opcional). Las credenciales solo se leen en el servidor.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Candemor Racing Team
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_CONNECTION_TIMEOUT_MS=8000

# Twitch: el Client Secret solo puede utilizarse en el servidor
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Fuentes deportivas (solo si se necesita sustituir el origen público por defecto)
# FATCAT_API_BASE_URL=https://fatcatrace.xyz/api/torneo
# FATCAT_ROUND_BASE_URL=https://fatcatrace.xyz/ronda
# FATCAT_ORIGIN=https://fatcatrace.xyz
