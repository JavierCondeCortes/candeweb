# Nombre de la imagen local o publicada en Docker Hub.
DOCKER_IMAGE=tu_usuario/candeweb:latest

# Puerto que se expondrá en el equipo anfitrión.
CANDEWEB_PORT=3000

# Genera un valor distinto antes del primer arranque en producción:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_TOKEN=cambia-este-token-antes-de-publicar

# Token Bearer compartido exclusivamente con el bot WebUpdates.
WEB_UPDATES_API_TOKEN=cambia-tambien-este-token-antes-de-publicar

# URL pública y SMTP opcional para enviar invitaciones de acceso.
PUBLIC_APP_URL=https://candemor.com
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Candemor Racing Team
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_CONNECTION_TIMEOUT_MS=8000

# Credenciales privadas de Twitch Helix. Déjalas vacías si no vas a usar sus datos ampliados.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Fuentes deportivas opcionales. Si se omiten, se utilizan las URLs predeterminadas.
# FATCAT_API_BASE_URL=https://fatcatrace.xyz/api/torneo
# FATCAT_ROUND_BASE_URL=https://fatcatrace.xyz/ronda
# FATCAT_ORIGIN=https://fatcatrace.xyz
